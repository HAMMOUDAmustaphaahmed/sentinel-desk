# The platform runs without any of this: tickets are then answered from the knowledge base
# and actions come from the runbooks. Set a model to turn the two agents on.

# --- Any OpenAI-compatible provider -------------------------------------------------
# LLM_PROVIDER=openai
# LLM_MODEL=<model name at that provider>
# LLM_API_KEY=<your key>
# LLM_BASE_URL=https://api.openai.com/v1                              # OpenAI
# LLM_BASE_URL=https://api.groq.com/openai/v1                         # Groq
# LLM_BASE_URL=https://api.mistral.ai/v1                              # Mistral
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  # Gemini
# LLM_BASE_URL=https://openrouter.ai/api/v1                           # OpenRouter
# LLM_BASE_URL=https://api.deepseek.com/v1                            # DeepSeek
# LLM_BASE_URL=http://localhost:11434/v1                              # a local server (no key)

# --- Claude -------------------------------------------------------------------------
# pip install anthropic
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5
# LLM_API_KEY=<your key>

# --- Optional -----------------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://user:password@localhost/sentineldesk
# BANK_URL=http://127.0.0.1:8100
# CORS_ORIGINS=http://localhost:5174
